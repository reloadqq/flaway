{
  "name": "flaway-dlc-loader",
  "productName": "flaway dlc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portable flaway dlc launcher",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "run": "npm run build && neu run",
    "update": "neu update && node -e \"require('fs').copyFileSync('resources/js/neutralino.js','public/js/neutralino.js')\"",
    "dist": "npm run build && neu build --release && node scripts/package.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@neutralinojs/neu": "11.7.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
