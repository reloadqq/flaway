static float rad_to_deg(float rad)
{
	return rad * (180.0f / 3.14159265358979323846f);
}

static float wrap_angle(float a)
{
	while (a > 180.0f) a -= 360.0f;
	while (a < -180.0f) a += 360.0f;
	return a;
}

static float calc_angle_diff(float from, float to)
{
	return wrap_angle(to - from);
}

static void angles_to_target(double eyex, double eyey, double eyez,
	double tx, double ty, double tz,
	float& out_yaw, float& out_pitch)
{
	double dx = tx - eyex;
	double dy = ty - eyey;
	double dz = tz - eyez;
	double horiz = std::sqrt(dx * dx + dz * dz);
	if (horiz < 0.001)
	{
		out_yaw = 0.0f;
		out_pitch = (dy > 0.0) ? -90.0f : 90.0f;
		return;
	}
	out_yaw = rad_to_deg(std::atan2(dz, dx)) - 90.0f;
	out_pitch = -rad_to_deg(std::atan2(dy, horiz));
	if (out_pitch > 90.0f) out_pitch = 90.0f;
	if (out_pitch < -90.0f) out_pitch = -90.0f;
}

// Velocity prediction with dynamic lead time.
// The lead scales with target speed: a slow target gets short lead (~50ms),
// a Speed II target gets up to 300ms lead. This is what makes prediction
// actually work for speed potions — the old code capped lead at 200ms which
// was too small for fast strafers.
static void apply_prediction(double& tx, double& ty, double& tz,
	jobject velocity, float lead_sec)
{
	if (!velocity || lead_sec <= 0.0f) return;

	auto env = flaway::instance->get_env();
	if (!env) return;

	jclass vec3d_class = sdk::classloader::find_class(env, sdk::mappings::vec3d_class_sig);
	if (!vec3d_class) return;

	jfieldID x_fid = env->GetFieldID(vec3d_class, sdk::mappings::vec3d_x_name, sdk::mappings::vec3d_x_sig);
	if (env->ExceptionCheck()) { env->ExceptionClear(); x_fid = nullptr; }
	jfieldID y_fid = env->GetFieldID(vec3d_class, sdk::mappings::vec3d_y_name, sdk::mappings::vec3d_y_sig);
	if (env->ExceptionCheck()) { env->ExceptionClear(); y_fid = nullptr; }
	jfieldID z_fid = env->GetFieldID(vec3d_class, sdk::mappings::vec3d_z_name, sdk::mappings::vec3d_z_sig);
	if (env->ExceptionCheck()) { env->ExceptionClear(); z_fid = nullptr; }
	if (x_fid && z_fid)
	{
		double vx = env->GetDoubleField(velocity, x_fid);
		if (env->ExceptionCheck()) { env->ExceptionClear(); vx = 0.0; }
		double vz = env->GetDoubleField(velocity, z_fid);
		if (env->ExceptionCheck()) { env->ExceptionClear(); vz = 0.0; }
		float ticks = lead_sec * 20.0f;
		tx += vx * ticks;
		tz += vz * ticks;
	}
	// Vertical prediction: include Y velocity for targets that are
	// jumping/falling. Scale by 0.7 to avoid pitch noise from walk-cycle
	// bob (the Y component oscillates during ground movement). When the
	// target is airborne with significant vy, 0.7 still tracks jumps well.
	if (y_fid)
	{
		double vy = env->GetDoubleField(velocity, y_fid);
		float ticks = lead_sec * 20.0f;
		if (std::abs(vy) > 0.3)
			ty += vy * ticks * 0.7;
	}
	env->DeleteLocalRef(vec3d_class);
}

// Compute dynamic lead time based on target speed and distance.
// Fast targets at long range need more lead. Slow targets need less.
static float compute_lead_time(double target_speed, double distance)
{
	// Base:0.05s for stationary, up to 0.35s for Speed II (7+ m/s)
	float lead = 0.05f + (float)std::min(target_speed / 20.0, 0.30);
	// Distance factor: farther targets need proportionally more lead
	// because angular velocity is lower but the time-of-flight is the same
	float dist_factor = 1.0f + (float)std::min(distance / 8.0, 0.5);
	lead *= dist_factor;
	return lead;
}

struct axis_params
{
	float accel;
	float max_vel;
	float damping;
	float deadzone;
	float micro_amp;
};

static float compute_axis(float diff, float dt, const axis_params& p,
	float& velocity, float& prev_diff)
{
	if (std::abs(diff) < p.deadzone)
	{
		velocity = 0.0f;
		float jitter = 0.0f;
		if (p.micro_amp > 0.0f)
			jitter = p.micro_amp * ((float)(std::rand() % 2000 - 1000) / 1000.0f);
		prev_diff = diff;
		return jitter;
	}

	float sign = (diff > 0.0f) ? 1.0f : -1.0f;
	float mag = std::abs(diff);

	float progress = 1.0f - std::min(mag / 90.0f, 1.0f);
	float ease_factor;
	if (progress < 0.4f)
	{
		float t = progress / 0.4f;
		ease_factor = 0.3f + 0.7f * t * t;
	}
	else if (progress < 0.7f)
	{
		ease_factor = 1.0f;
	}
	else
	{
		float t = (progress - 0.7f) / 0.3f;
		ease_factor = 1.0f - t * t * t;
	}

	float spring_force = p.accel * ease_factor;
	velocity += (spring_force * sign - p.damping * velocity) * dt;

	float max_vel = p.max_vel > 0.0f ? p.max_vel : p.accel;
	if (velocity > max_vel) velocity = max_vel;
	if (velocity < -max_vel) velocity = -max_vel;

	float move = velocity * dt;
	if (sign > 0.0f && move > diff) move = diff;
	if (sign < 0.0f && move < diff) move = diff;

	float jitter = 0.0f;
	if (p.micro_amp > 0.0f)
		jitter = p.micro_amp * ((float)(std::rand() % 2000 - 1000) / 1000.0f);

	prev_diff = diff;
	return move + jitter;
}

static void reset_aim_state()
{
	g_velocity_yaw = 0.0f;
	g_velocity_pitch = 0.0f;
	g_prev_diff_yaw = 0.0f;
	g_prev_diff_pitch = 0.0f;
	g_reaction_frames = 0;
	g_has_goal = false;
	g_last_apply_us = 0;
}

// Per-frame smooth rotation application at 60fps.
// Accumulates small steps and sends a look packet when the pending delta
// exceeds a variable threshold (0.06..0.13 deg). This produces natural
// non-zero deltas that avoid AimModulo360.
static void apply_smooth_rotation()
{
	if (!g_has_goal) return;

	auto env = flaway::instance->get_env();
	if (!env) return;

	jobject p = sdk::instance->get_player();
	if (!p) return;

	sdk::entity_client lc(p);
	float cy = lc.get_yaw();
	float cp = lc.get_pitch();

	float dy = wrap_angle(g_goal_yaw - cy);
	float dp = g_goal_pitch - cp;

	long long now = now_us();
	float dt = g_last_apply_us ? (float)(now - g_last_apply_us) / 16666.7f : 1.0f;
	g_last_apply_us = now;
	if (dt < 0.4f) dt = 0.4f;
	if (dt > 3.0f) dt = 3.0f;

	// Randomized factor prevents constant-ratio geometric decay.
	// 0.20..0.40 (was 0.14..0.30): the view closes on the goal faster right
	// after a lock while staying proportional, so it still cannot overshoot.
	float factor = 0.20f + 0.20f * (float)(std::rand() % 1000) / 1000.0f;
	float step_y = dy * factor * dt;
	// Pitch is deliberately the slow, smooth axis: humans move the view far
	// less aggressively vertically, and sharp Y deltas are what trips
	// rotation checks.
	float step_p = dp * factor * 0.55f * dt;

	// Dynamic caps: higher base caps when the error is large so the aim
	// can actually track a speed-boosted target without being throttled.
	// At small errors, use tight caps for precision.
	float cap_y = 1.8f * dt;
	float cap_p = 0.8f * dt;
	if (std::abs(dy) > 8.0f) cap_y = std::min(std::abs(dy) * 0.6f, 6.0f) * dt;
	if (std::abs(dp) > 5.0f) cap_p = std::min(std::abs(dp) * 0.4f, 2.0f) * dt;
	if (step_y > cap_y) step_y = cap_y;
	if (step_y < -cap_y) step_y = -cap_y;
	if (step_p > cap_p) step_p = cap_p;
	if (step_p < -cap_p) step_p = -cap_p;

	// Accumulate until pending delta >= variable threshold.
	static float pend_y = 0.0f, pend_p = 0.0f;
	pend_y += step_y;
	pend_p += step_p;

	const float k_send_threshold = 0.06f + 0.07f * (float)(std::rand() % 1000) / 1000.0f;
	bool send_y = globals::aimassist_horizontal && std::abs(pend_y) >= k_send_threshold;
	bool send_p = globals::aimassist_vertical && std::abs(pend_p) >= k_send_threshold;

	// AimModulo360: push micro-step when view is on goal to avoid delta==0.
	if (!send_y && !send_p)
	{
		if (std::abs(dy) > 0.02f || std::abs(dp) > 0.02f)
		{
			float micro = 0.03f + 0.12f * (float)(std::rand() % 1000) / 1000.0f;
			float micro_p = micro * 0.5f;
			if (std::rand() % 2)
			{
				if (globals::aimassist_horizontal)
					lc.set_yaw(wrap_angle(cy + micro));
				else
					lc.set_pitch(cp + micro_p < -89.0f ? -89.0f : (cp + micro_p > 89.0f ? 89.0f : cp + micro_p));
			}
			else
			{
				if (globals::aimassist_vertical)
					lc.set_pitch(cp - micro_p < -89.0f ? -89.0f : (cp - micro_p > 89.0f ? 89.0f : cp - micro_p));
				else
					lc.set_yaw(wrap_angle(cy - micro));
			}
			g_was_aiming = true;
		}
		env->DeleteLocalRef(p);
		return;
	}

	// Right-skewed tail + hard floor to avoid AimModulo360.
	float out_y = 0.0f, out_p = 0.0f;
	float tail = 0.005f + (float)(std::rand() % 1000) / 1000.0f
		* (float)(std::rand() % 1000) / 1000.0f * 0.09f;
	tail = (std::rand() % 2 ? tail : -tail);
	if (send_y)
	{
		out_y = pend_y + tail;
		if (std::rand() % 100 < 3 && std::abs(out_y) > 0.2f)
			out_y = -out_y * 0.05f;
		if (out_y > 10.0f) out_y = 10.0f;
		if (out_y < -10.0f) out_y = -10.0f;
		if (out_y > -0.02f && out_y < 0.02f) out_y = out_y >= 0.0f ? 0.02f : -0.02f;
		pend_y = 0.0f;
	}
	if (send_p)
	{
		out_p = pend_p + tail * 0.5f;
		if (out_p > 4.0f) out_p = 4.0f;
		if (out_p < -4.0f) out_p = -4.0f;
		if (out_p > -0.02f && out_p < 0.02f) out_p = out_p >= 0.0f ? 0.02f : -0.02f;
		pend_p = 0.0f;
	}

	if (send_y)
		lc.set_yaw(wrap_angle(cy + out_y));
	if (send_p)
		lc.set_pitch(cp + out_p < -89.0f ? -89.0f : (cp + out_p > 89.0f ? 89.0f : cp + out_p));

	g_was_aiming = true;
	env->DeleteLocalRef(p);
}

static void do_return_step()
{
	auto env = flaway::instance->get_env();
	if (!env) { g_return_mode = false; return; }

	{
		static int r_mx = 0, r_my = 0;
		int mx = x11_helper::get_cursor_x();
		int my = x11_helper::get_cursor_y();
		if (r_mx || r_my)
		{
			int dm = std::abs(mx - r_mx) + std::abs(my - r_my);
			if (dm > 3) { g_return_mode = false; return; }
		}
		r_mx = mx; r_my = my;
	}

	jobject p = sdk::instance->get_player();
	if (!p) { g_return_mode = false; return; }

	sdk::entity_client lc(p);
	float cy = lc.get_yaw();
	float cp = lc.get_pitch();

	float dy = wrap_angle(g_restore_yaw - cy);
	float dp = g_restore_pitch - cp;

	long long now = now_us();
	if (!g_return_start_us) g_return_start_us = now;
	float dt = 1.0f;
	if (g_return_last_us)
	{
		dt = (float)(now - g_return_last_us) / 16666.7f;
		if (dt < 0.4f) dt = 0.4f;
		if (dt > 3.0f) dt = 3.0f;
	}
	g_return_last_us = now;

	if ((std::abs(dy) < 0.4f && std::abs(dp) < 0.4f) ||
		now - g_return_start_us > 700000LL)
	{
		g_return_mode = false;
		env->DeleteLocalRef(p);
		return;
	}

	float factor = 0.18f + 0.12f * (float)(std::rand() % 1000) / 1000.0f;
	float step_y = dy * factor * dt;
	float step_p = dp * factor * 0.55f * dt;
	float cap_y = 1.8f * dt;
	float cap_p = 0.8f * dt;
	if (step_y > cap_y) step_y = cap_y;
	if (step_y < -cap_y) step_y = -cap_y;
	if (step_p > cap_p) step_p = cap_p;
	if (step_p < -cap_p) step_p = -cap_p;

	step_y += ((float)(std::rand() % 1999) - 999.0f) / 1000.0f * 0.012f;
	step_p += ((float)(std::rand() % 1999) - 999.0f) / 1000.0f * 0.005f;

	lc.set_yaw(wrap_angle(cy + step_y));
	lc.set_pitch(cp + step_p < -89.0f ? -89.0f : (cp + step_p > 89.0f ? 89.0f : cp + step_p));
	env->DeleteLocalRef(p);
}

void flaway::modules::aimassist::run()
{
	if (g_return_mode)
	{
		do_return_step();
		return;
	}

	if (!globals::aimassist_enabled)
	{
		if (g_was_aiming)
		{
			reset_aim_state();
		}
		g_was_aiming = false;
		g_locked_id = -1;
		g_lost_frames = 0;
		g_mouse_tracked = false;
		g_prev_key_state = 0;
		return;
	}

	// 20 Hz scan when locked, 20 Hz idle so a fresh target is picked up in at
	// most 50 ms instead of 200 ms.
	{
		static long long g_last_scan_us = 0;
		long long now_thr = now_us();
		long long interval = 50000;
		if (g_last_scan_us && now_thr - g_last_scan_us < interval)
		{
			apply_smooth_rotation();
			return;
		}
		g_last_scan_us = now_thr;
	}

	if (!seeded)
	{
		std::srand((unsigned int)std::time(nullptr));
		seeded = true;
	}

	auto env = flaway::instance->get_env();
	if (!env) return;

	jobject player = sdk::instance->get_player();
	if (!player) return;

	sdk::entity_client local(player);
	double px = local.get_x();
	double py = local.get_y() + 1.62;
	double pz = local.get_z();
	float current_yaw = local.get_yaw();
	float current_pitch = local.get_pitch();

	jobject world = sdk::instance->get_world();
	if (!world) { env->DeleteLocalRef(player); return; }

	sdk::world_client wc(world);
	std::vector<jobject> players = wc.get_players();
	std::vector<jobject> mobs;

	if (globals::mobstats_enabled)
	{
		jclass living_cls = sdk::classloader::find_class(env, sdk::mappings::living_entity_class_sig);
		jclass player_cls = sdk::classloader::find_class(env, sdk::mappings::player_entity_class_sig);
		if (living_cls)
		{
			std::vector<jobject> all_entities = wc.get_entities();
			for (jobject e : all_entities)
			{
				if (!e) continue;
				if (player_cls && env->IsInstanceOf(e, player_cls))
				{
					env->DeleteLocalRef(e);
					continue;
				}
				if (!env->IsInstanceOf(e, living_cls))
				{
					env->DeleteLocalRef(e);
					continue;
				}
				mobs.push_back(e);
			}
		}
		if (player_cls) env->DeleteLocalRef(player_cls);
		if (living_cls) env->DeleteLocalRef(living_cls);
	}

	// ----- Target selection with persistence -----
	jobject best = nullptr;
	int best_id = -1;
	float best_angle = globals::aimassist_fov;
	// The entity we are already locked on: captured separately so it can be
	// held instead of swapping to a fresher candidate.
	jobject held_obj = nullptr;
	double held_dist = 0.0;
	float held_angle = 0.0f;

	for (jobject p : players)
	{
		if (!p) continue;
		sdk::entity_client ec(p);
		if (ec.is_same_object(player)) continue;

		int eid = ec.get_entity_id();
		bool held = (g_locked_id != -1 && eid == g_locked_id);

		double ex = ec.get_x();
		double ey = ec.get_y() + 1.62;
		double ez = ec.get_z();
		double dist = std::sqrt((ex - px) * (ex - px) + (ey - py) * (ey - py) + (ez - pz) * (ez - pz));
		if (dist > globals::aimassist_max_distance && !held) continue;

		float target_yaw, target_pitch;
		angles_to_target(px, py, pz, ex, ey, ez, target_yaw, target_pitch);
		float dyaw = std::abs(calc_angle_diff(current_yaw, target_yaw));
		float dpitch = std::abs(calc_angle_diff(current_pitch, target_pitch));
		float angle_dist = std::sqrt(dyaw * dyaw + dpitch * dpitch);

		if (held)
		{
			held_obj = p;
			held_dist = dist;
			held_angle = angle_dist;
		}

		float score = angle_dist;
		if (held)
			score *= 0.45f;

		if (score < best_angle)
		{
			best_angle = score;
			best = p;
			best_id = eid;
		}
	}

	for (jobject m : mobs)
	{
		if (!m) continue;
		sdk::entity_client ec(m);
		if (ec.is_same_object(player)) continue;

		int eid = ec.get_entity_id();
		bool held = (g_locked_id != -1 && eid == g_locked_id);

		double ex = ec.get_x();
		double ey = ec.get_y() + 1.0;
		double ez = ec.get_z();
		double dist = std::sqrt((ex - px) * (ex - px) + (ey - py) * (ey - py) + (ez - pz) * (ez - pz));
		if (dist > globals::aimassist_max_distance && !held) continue;

		float target_yaw, target_pitch;
		angles_to_target(px, py, pz, ex, ey, ez, target_yaw, target_pitch);
		float dyaw = std::abs(calc_angle_diff(current_yaw, target_yaw));
		float dpitch = std::abs(calc_angle_diff(current_pitch, target_pitch));
		float angle_dist = std::sqrt(dyaw * dyaw + dpitch * dpitch);

		if (held)
		{
			held_obj = m;
			held_dist = dist;
			held_angle = angle_dist;
		}

		float score = angle_dist;
		if (held)
			score *= 0.45f;

		if (score < best_angle)
		{
			best_angle = score;
			best = m;
			best_id = eid;
		}
	}

	// ----- No mid-fight target swapping -----
	// While a target is locked the aim stays on that entity even if another
	// one drifts closer to the crosshair: instant target swaps are a
	// detection signal. The lock only goes away through the normal lost /
	// grace path below (or when the target leaves reach or the FOV cone).
	if (g_locked_id != -1)
	{
		float held_limit = globals::aimassist_fov * 3.0f;
		if (held_obj &&
			held_dist <= globals::aimassist_max_distance &&
			held_angle <= held_limit)
		{
			best = held_obj;
			best_id = g_locked_id;
		}
		else
		{
			best = nullptr;
			best_id = -1;
		}
	}

	// ----- Mouse movement detachment -----
	if (g_mouse_tracked)
	{
		int mx = x11_helper::get_cursor_x();
		int my = x11_helper::get_cursor_y();
		int dmov = std::abs(mx - g_prev_mouse_x) + std::abs(my - g_prev_mouse_y);

		// A couple of pixels of jitter must not drop the lock: stray movement
		// accumulates and only detaches once it clearly adds up to a
		// deliberate turn. While the mouse stays put the counter decays, so
		// micro-noise never unlocks, and a small drift keeps the target.
		static int s_stray = 0;
		if (dmov > 3)
			s_stray += dmov;
		else
			s_stray -= 3;
		if (s_stray < 0) s_stray = 0;

		if (s_stray > 20 && g_was_aiming)
		{
			s_stray = 0;
			g_locked_id = -1;
			g_lost_frames = 0;
			reset_aim_state();
			g_was_aiming = false;
			g_mouse_tracked = true;
			g_prev_mouse_x = mx;
			g_prev_mouse_y = my;
			for (jobject p : players) if (p) env->DeleteLocalRef(p);
			for (jobject m : mobs) if (m) env->DeleteLocalRef(m);
			env->DeleteLocalRef(world);
			env->DeleteLocalRef(player);
			return;
		}
		g_prev_mouse_x = mx;
		g_prev_mouse_y = my;
	}
	g_mouse_tracked = true;
	g_prev_mouse_x = x11_helper::get_cursor_x();
	g_prev_mouse_y = x11_helper::get_cursor_y();

	// ----- Keybind release detachment -----
	{
		int key_state = x11_helper::is_key_pressed((unsigned int)globals::aimassist_keybind) ? 1 : 0;
		if (g_prev_key_state == 1 && key_state == 0 && g_was_aiming)
		{
			g_locked_id = -1;
			g_lost_frames = 0;
			reset_aim_state();
			g_was_aiming = false;
			g_prev_key_state = key_state;
			for (jobject p : players) if (p) env->DeleteLocalRef(p);
			for (jobject m : mobs) if (m) env->DeleteLocalRef(m);
			env->DeleteLocalRef(world);
			env->DeleteLocalRef(player);
			return;
		}
		g_prev_key_state = key_state;
	}

	// ----- Target lost handling -----
	if (!best)
	{
		// Telemetry: record lost frame
		if (globals::aimassist_telemetry_enabled && g_locked_id != -1)
		{
			telemetry::snapshot snap = {};
			snap.time_us = now_us();
			snap.phase = "lost";
			snap.lpx = px; snap.lpy = py; snap.lpz = pz;
			snap.lyaw = current_yaw; snap.lpitch = current_pitch;
			snap.target_id = g_locked_id;
			snap.target_dist = 0;
			snap.angle_mag = 0;
			telemetry::record(snap);
		}

		g_lost_frames++;
		if (g_lost_frames > 45)
		{
			g_locked_id = -1;
			reset_aim_state();
			g_was_aiming = false;
			if (g_restore_valid)
			{
				g_return_mode = true;
				g_return_start_us = 0;
				g_return_last_us = 0;
			}
		}
		if (!g_was_aiming)
		{
			jobject lp2 = sdk::instance->get_player();
			if (lp2)
			{
				sdk::entity_client le(lp2);
				g_restore_yaw = le.get_yaw();
				g_restore_pitch = le.get_pitch();
				g_restore_valid = true;
				env->DeleteLocalRef(lp2);
			}
		}
		for (jobject p : players) if (p) env->DeleteLocalRef(p);
		for (jobject m : mobs) if (m) env->DeleteLocalRef(m);
		env->DeleteLocalRef(world);
		env->DeleteLocalRef(player);
		return;
	}

	// New target acquired
	if (g_locked_id != best_id)
	{
		g_return_mode = false;
		g_locked_id = best_id;
		g_reaction_frames = 0;
		g_target_acquire_us = now_us();
		g_velocity_yaw = 0.0f;
		g_velocity_pitch = 0.0f;
		g_prev_diff_yaw = 0.0f;
		g_prev_diff_pitch = 0.0f;
	}

	g_locked_id = best_id;
	g_lost_frames = 0;

	sdk::entity_client target(best);
	double ex = target.get_x();
	double ey = target.get_y() + 1.4;
	double ez = target.get_z();

	// Compute target velocity magnitude for dynamic prediction and motor scaling
	double target_speed = 0.0;
	double saved_tvx = 0.0, saved_tvy = 0.0, saved_tvz = 0.0;
	{
		jobject target_vel = target.get_velocity();
		if (target_vel)
		{
			jclass vec3d_class = sdk::classloader::find_class(env, sdk::mappings::vec3d_class_sig);
			if (vec3d_class)
			{
				jfieldID x_fid = env->GetFieldID(vec3d_class, sdk::mappings::vec3d_x_name, sdk::mappings::vec3d_x_sig);
				if (env->ExceptionCheck()) { env->ExceptionClear(); x_fid = nullptr; }
				jfieldID y_fid = env->GetFieldID(vec3d_class, sdk::mappings::vec3d_y_name, sdk::mappings::vec3d_y_sig);
				if (env->ExceptionCheck()) { env->ExceptionClear(); y_fid = nullptr; }
				jfieldID z_fid = env->GetFieldID(vec3d_class, sdk::mappings::vec3d_z_name, sdk::mappings::vec3d_z_sig);
				if (env->ExceptionCheck()) { env->ExceptionClear(); z_fid = nullptr; }
				if (x_fid)
				{
					saved_tvx = env->GetDoubleField(target_vel, x_fid);
					if (env->ExceptionCheck()) { env->ExceptionClear(); saved_tvx = 0.0; }
				}
				if (y_fid)
				{
					saved_tvy = env->GetDoubleField(target_vel, y_fid);
					if (env->ExceptionCheck()) { env->ExceptionClear(); saved_tvy = 0.0; }
				}
				if (z_fid)
				{
					saved_tvz = env->GetDoubleField(target_vel, z_fid);
					if (env->ExceptionCheck()) { env->ExceptionClear(); saved_tvz = 0.0; }
				}
				target_speed = std::sqrt(saved_tvx * saved_tvx + saved_tvz * saved_tvz);
				env->DeleteLocalRef(vec3d_class);
			}
			env->DeleteLocalRef(target_vel);
		}
	}

	// Distance for prediction scaling
	double distance_to_target = std::sqrt(
		(ex - px) * (ex - px) + (ey - py) * (ey - py) + (ez - pz) * (ez - pz));

	// ----- Dynamic velocity prediction -----
	float lead_sec = 0.0f;
	if (globals::aimassist_prediction > 0.0f)
	{
		lead_sec = compute_lead_time(target_speed, distance_to_target);
		// User slider scales the dynamic lead (0 = no prediction, 1 = full)
		lead_sec *= globals::aimassist_prediction / 0.18f;
		if (lead_sec > 0.50f) lead_sec = 0.50f;

		jobject target_vel = target.get_velocity();
		if (target_vel)
		{
			apply_prediction(ex, ey, ez, target_vel, lead_sec);
			env->DeleteLocalRef(target_vel);
		}
	}

	float target_yaw, target_pitch;
	angles_to_target(px, py, pz, ex, ey, ez, target_yaw, target_pitch);

	float dyaw = calc_angle_diff(current_yaw, target_yaw);
	float dpitch = calc_angle_diff(current_pitch, target_pitch);
	float angle_magnitude = std::sqrt(dyaw * dyaw + dpitch * dpitch);
	if (angle_magnitude < 0.02f)
	{
		for (jobject p : players) if (p) env->DeleteLocalRef(p);
		for (jobject m : mobs) if (m) env->DeleteLocalRef(m);
		env->DeleteLocalRef(world);
		env->DeleteLocalRef(player);
		return;
	}

	// ----- Reaction delay -----
	g_reaction_frames++;
	float reaction_delay = k_reaction_delay_ms;
	int reaction_frames_needed = (int)(reaction_delay / 16.67f);
	if (g_reaction_frames < reaction_frames_needed)
	{
		for (jobject p : players) if (p) env->DeleteLocalRef(p);
		for (jobject m : mobs) if (m) env->DeleteLocalRef(m);
		env->DeleteLocalRef(world);
		env->DeleteLocalRef(player);
		return;
	}

	// ----- Delta time -----
	long long now = now_us();
	float dt = 0.0167f;
	if (g_last_aim_us > 0)
	{
		dt = (float)(now - g_last_aim_us) / 1000000.0f;
		if (dt < 0.001f) dt = 0.001f;
		if (dt > 0.1f) dt = 0.1f;
	}
	g_last_aim_us = now;

	// ----- Smoothing / speed factor -----
	float smoothing = globals::aimassist_smoothing;
	if (smoothing < 0.0f) smoothing = 0.0f;
	if (smoothing > 99.0f) smoothing = 99.0f;
	float speed_factor = globals::aimassist_speed * (1.0f - smoothing / 100.0f);
	if (speed_factor < 0.1f) speed_factor = 0.1f;

	// ----- Speed-based motor boost -----
	// When the target is moving fast (Speed potion), increase the motor
	// speed proportionally so the aim can keep up. A stationary target
	// uses the base speed_factor; a Speed II target (7+ m/s) gets ~2x boost.
	float speed_boost = 1.0f + (float)std::min(target_speed / 5.0, 1.5);
	speed_factor *= speed_boost;

	// ----- Per-axis motor parameters -----
	// accel / max_vel are deliberately high: the goal has to start moving the
	// same frame the target is detected, and a big angle correction has to be
	// able to run at speed. Damping and the ease curve are untouched.
	axis_params yaw_params;
	yaw_params.accel = 780.0f * speed_factor;
	yaw_params.max_vel = 220.0f;
	yaw_params.damping = 7.0f * (1.0f - k_overshoot_correction * 0.5f);
	yaw_params.deadzone = 0.01f;
	yaw_params.micro_amp = k_micro_jitter * speed_factor;

	axis_params pitch_params;
	// Y axis kept soft: slower ramp, lower top speed and much less random
	// micro-noise than yaw, so vertical deltas stay human-shaped.
	pitch_params.accel = 400.0f * speed_factor;
	pitch_params.max_vel = 95.0f;
	pitch_params.damping = 8.0f * (1.0f - k_overshoot_correction * 0.5f);
	pitch_params.deadzone = k_pitch_deadzone;
	pitch_params.micro_amp = k_micro_jitter * speed_factor * 0.35f;

	// ----- Compute aim adjustments -----
	float yaw_move = 0.0f;
	float pitch_move = 0.0f;

	if (globals::aimassist_horizontal)
	{
		yaw_move = compute_axis(dyaw, dt, yaw_params,
			g_velocity_yaw, g_prev_diff_yaw);
	}

	if (globals::aimassist_vertical)
	{
		float pitch_dz = k_pitch_deadzone;
		if (std::abs(current_pitch) < 10.0f && std::abs(dpitch) < 5.0f)
		{
			pitch_params.accel *= 0.5f;
			pitch_params.damping *= 1.8f;
			pitch_params.deadzone = std::max(pitch_dz, 2.0f);
		}

		pitch_move = compute_axis(dpitch, dt, pitch_params,
			g_velocity_pitch, g_prev_diff_pitch);
	}

	// ----- Optional randomized variation -----
	if (globals::aimassist_randomize && globals::aimassist_random_strength > 0.0f)
	{
		float dist_factor = angle_magnitude / 90.0f;
		if (dist_factor > 1.0f) dist_factor = 1.0f;

		static float smooth_noise_yaw = 0.0f;
		static float smooth_noise_pitch = 0.0f;
		static float target_ny = 0.0f;
		static float target_np = 0.0f;
		static int adjust_timer = 0;

		smooth_noise_yaw += (target_ny - smooth_noise_yaw) * 0.08f;
		smooth_noise_pitch += (target_np - smooth_noise_pitch) * 0.08f;
		adjust_timer = std::max(0, adjust_timer - 1);

		if (adjust_timer <= 0)
		{
			target_ny = ((float)(std::rand() % 200) - 100.0f) / 100.0f;
			target_np = ((float)(std::rand() % 200) - 100.0f) / 100.0f;
			adjust_timer = 20 + (std::rand() % 30);
		}

		float max_offset = globals::aimassist_random_strength * (0.15f + dist_factor * 0.8f);
		yaw_move += smooth_noise_yaw * max_offset;
		pitch_move += smooth_noise_pitch * max_offset;
	}

	// ----- Overshoot correction -----
	if (g_prev_diff_yaw != 0.0f && dyaw != 0.0f)
	{
		if ((g_prev_diff_yaw > 0.0f && dyaw < 0.0f) ||
			(g_prev_diff_yaw < 0.0f && dyaw > 0.0f))
		{
			g_velocity_yaw *= (1.0f - k_overshoot_correction);
		}
	}
	if (g_prev_diff_pitch != 0.0f && dpitch != 0.0f)
	{
		if ((g_prev_diff_pitch > 0.0f && dpitch < 0.0f) ||
			(g_prev_diff_pitch < 0.0f && dpitch > 0.0f))
		{
			g_velocity_pitch *= (1.0f - k_overshoot_correction);
		}
	}

	// ----- Store goal + apply smoothly -----
	g_goal_yaw = wrap_angle(current_yaw + yaw_move);
	g_goal_pitch = current_pitch + pitch_move;
	if (g_goal_pitch > 89.0f) g_goal_pitch = 89.0f;
	if (g_goal_pitch < -89.0f) g_goal_pitch = -89.0f;
	g_has_goal = true;

	// ----- Telemetry: fill angular data and record -----
	if (globals::aimassist_telemetry_enabled)
	{
		// Detect overshoot
		bool overshot = false;
		if (g_prev_diff_yaw != 0.0f && dyaw != 0.0f)
			overshot = ((g_prev_diff_yaw > 0.0f && dyaw < 0.0f) || (g_prev_diff_yaw < 0.0f && dyaw > 0.0f));

		float sm = globals::aimassist_smoothing;
		if (sm < 0.0f) sm = 0.0f;
		if (sm > 99.0f) sm = 99.0f;
		float sf = globals::aimassist_speed * (1.0f - sm / 100.0f);
		if (sf < 0.1f) sf = 0.1f;
		float sb = 1.0f + (float)std::min(target_speed / 5.0, 1.5);
		sf *= sb;

		telemetry::snapshot snap = {};
		snap.time_us = now_us();
		snap.phase = "aim";
		snap.lpx = px; snap.lpy = py; snap.lpz = pz;
		snap.lyaw = current_yaw; snap.lpitch = current_pitch;
		snap.lvx = 0; snap.lvy = 0; snap.lvz = 0;
		snap.ttx = target.get_x();
		snap.tty = target.get_y() + 1.4;
		snap.ttz = target.get_z();
		snap.tvx = saved_tvx; snap.tvy = saved_tvy; snap.tvz = saved_tvz;
		snap.target_id = g_locked_id;
		snap.target_dist = distance_to_target;
		snap.ppx = ex; snap.ppy = ey; snap.ppz = ez;
		snap.pyaw = target_yaw; snap.ppitch = target_pitch;
		snap.diff_yaw = dyaw; snap.diff_pitch = dpitch;
		snap.angle_mag = angle_magnitude;
		snap.lead_sec = lead_sec;
		snap.speed_factor = sf;
		snap.target_speed = target_speed;
		snap.yaw_move = yaw_move;
		snap.pitch_move = pitch_move;
		snap.overshoot = overshot;

		// --- Read new combat data via JNI ---
		snap.player_sprint = 0;
		snap.player_on_ground = local.is_on_ground() ? 1 : 0;
		snap.target_sprint = 0;
		snap.target_on_ground = target.is_on_ground() ? 1 : 0;
		snap.target_health = 0.0f;
		snap.target_hurt_time = 0;
		snap.attack_cooldown = 0.0f;
		snap.hurt_time = 0;

		// Player sprint
		{
			jclass entity_cls = sdk::classloader::find_class(env, sdk::mappings::entity_class_sig);
			if (entity_cls)
			{
				jmethodID sprint_mid = env->GetMethodID(entity_cls, sdk::mappings::is_sprinting_name, sdk::mappings::is_sprinting_sig);
				if (env->ExceptionCheck()) { env->ExceptionClear(); sprint_mid = nullptr; }
				if (sprint_mid)
				{
					jboolean sp = env->CallBooleanMethod(player, sprint_mid);
					if (env->ExceptionCheck()) { env->ExceptionClear(); sp = JNI_FALSE; }
					snap.player_sprint = sp ? 1 : 0;
				}
				env->DeleteLocalRef(entity_cls);
			}
		}

		// Target sprint
		{
			jclass entity_cls = sdk::classloader::find_class(env, sdk::mappings::entity_class_sig);
			if (entity_cls)
			{
				jmethodID sprint_mid = env->GetMethodID(entity_cls, sdk::mappings::is_sprinting_name, sdk::mappings::is_sprinting_sig);
				if (env->ExceptionCheck()) { env->ExceptionClear(); sprint_mid = nullptr; }
				if (sprint_mid)
				{
					jboolean ts = env->CallBooleanMethod(best, sprint_mid);
					if (env->ExceptionCheck()) { env->ExceptionClear(); ts = JNI_FALSE; }
					snap.target_sprint = ts ? 1 : 0;
				}
				env->DeleteLocalRef(entity_cls);
			}
		}

		// Target health + hurt time (LivingEntity)
		{
			jclass le_cls = sdk::classloader::find_class(env, sdk::mappings::living_entity_class_sig);
			if (le_cls)
			{
				jmethodID health_mid = env->GetMethodID(le_cls, sdk::mappings::living_entity_get_health_name, sdk::mappings::living_entity_get_health_sig);
				if (env->ExceptionCheck()) { env->ExceptionClear(); health_mid = nullptr; }
				if (health_mid)
				{
					jfloat hp = env->CallFloatMethod(best, health_mid);
					if (env->ExceptionCheck()) { env->ExceptionClear(); hp = 0.0f; }
					snap.target_health = hp;
				}
				jfieldID hurt_fid = env->GetFieldID(le_cls, sdk::mappings::living_entity_hurt_time_name, sdk::mappings::living_entity_hurt_time_sig);
				if (env->ExceptionCheck()) { env->ExceptionClear(); hurt_fid = nullptr; }
				if (hurt_fid)
				{
					jint ht = env->GetIntField(best, hurt_fid);
					if (env->ExceptionCheck()) { env->ExceptionClear(); ht = 0; }
					snap.target_hurt_time = ht;
				}
				env->DeleteLocalRef(le_cls);
			}
		}

		// Player hurt time (LivingEntity)
		{
			jclass le_cls = sdk::classloader::find_class(env, sdk::mappings::living_entity_class_sig);
			if (le_cls)
			{
				jfieldID hurt_fid = env->GetFieldID(le_cls, sdk::mappings::living_entity_hurt_time_name, sdk::mappings::living_entity_hurt_time_sig);
				if (env->ExceptionCheck()) { env->ExceptionClear(); hurt_fid = nullptr; }
				if (hurt_fid)
				{
					jint ht = env->GetIntField(player, hurt_fid);
					if (env->ExceptionCheck()) { env->ExceptionClear(); ht = 0; }
					snap.hurt_time = ht;
				}
				env->DeleteLocalRef(le_cls);
			}
		}

		// Attack cooldown (MinecraftClient.attackCooldown field)
		{
			jclass mc_cls = sdk::classloader::find_class(env, sdk::mappings::minecraftclass_sig);
			if (mc_cls)
			{
				jfieldID inst_fid = env->GetStaticFieldID(mc_cls, sdk::mappings::minecraftclient_name, sdk::mappings::minecraftclient_sig);
				if (env->ExceptionCheck()) { env->ExceptionClear(); inst_fid = nullptr; }
				if (inst_fid)
				{
					jobject mc = env->GetStaticObjectField(mc_cls, inst_fid);
					if (env->ExceptionCheck()) { env->ExceptionClear(); mc = nullptr; }
					if (mc)
					{
						jfieldID cd_fid = env->GetFieldID(mc_cls, sdk::mappings::attack_cooldown_name, sdk::mappings::attack_cooldown_sig);
						if (env->ExceptionCheck()) { env->ExceptionClear(); cd_fid = nullptr; }
						if (cd_fid)
						{
							jint cd = env->GetIntField(mc, cd_fid);
							if (env->ExceptionCheck()) { env->ExceptionClear(); cd = 0; }
							snap.attack_cooldown = (float)cd / 20.0f;
						}
						env->DeleteLocalRef(mc);
					}
				}
				env->DeleteLocalRef(mc_cls);
			}
		}

		telemetry::record(snap);
	}

	apply_smooth_rotation();

	g_was_aiming = true;

	for (jobject p : players) if (p) env->DeleteLocalRef(p);
	for (jobject m : mobs) if (m) env->DeleteLocalRef(m);
	env->DeleteLocalRef(world);
	env->DeleteLocalRef(player);
}

int flaway::modules::aimassist::get_locked_id()
{
	return g_locked_id;
}

void flaway::modules::aimassist::draw_fov()
{
	if (!globals::aimassist_enabled) return;
	if (!globals::esp_show_fov) return;

	ImDrawList* dl = ImGui::GetBackgroundDrawList();
	if (!dl) return;

	float fov = globals::aimassist_fov;
	float w = (float)ImGui::GetIO().DisplaySize.x;
	float h = (float)ImGui::GetIO().DisplaySize.y;
	ImVec2 center(w * 0.5f, h * 0.5f);
	float radius = fov * std::min(w, h) / 180.0f;

	ImU32 col = IM_COL32(
		(int)(globals::esp_fov_color[0] * 255),
		(int)(globals::esp_fov_color[1] * 255),
		(int)(globals::esp_fov_color[2] * 255),
		(int)(globals::esp_fov_color[3] * 255));

	dl->AddCircle(center, radius, col, 64, 1.5f);
	dl->AddCircleFilled(center, radius, col & IM_COL32(0, 0, 0, 32));
}

void flaway::modules::aimassist::cleanup()
{
	telemetry::close_csv();
	g_locked_id = -1;
	g_was_aiming = false;
	g_has_goal = false;
	g_return_mode = false;
}
