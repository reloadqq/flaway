static inline long long now_us()
{
	return std::chrono::duration_cast<std::chrono::microseconds>(
		std::chrono::steady_clock::now().time_since_epoch()).count();
}

// ===== Aimbot Telemetry =====
// Collects position, velocity, angle, and prediction data every ~1 second.
// Output: ~/.minecraft/flaway/aimbot_telemetry.csv
// Columns:
//   time_us,phase,
//   local_px,local_py,local_pz,local_vx,local_vy,local_vz,local_yaw,local_pitch,
//   target_tx,target_ty,target_tz,target_vx,target_vy,target_vz,target_id,target_dist,
//   pred_px,pred_py,pred_pz,pred_yaw,pred_pitch,
//   diff_yaw,diff_pitch,angle_mag,lead_sec,speed_factor,target_speed,
//   yaw_move,pitch_move,overshoot
namespace telemetry
{
	struct snapshot
	{
		long long time_us;
		const char* phase; // "scan","aim","lost"

		// Local player
		double lpx, lpy, lpz;
		double lvx, lvy, lvz;
		float lyaw, lpitch;
		int player_sprint;
		int player_on_ground;

		// Target (before prediction)
		double ttx, tty, ttz;
		double tvx, tvy, tvz;
		int target_id;
		double target_dist;
		int target_sprint;
		int target_on_ground;
		float target_health;
		int target_hurt_time;

		// After prediction (aim point)
		double ppx, ppy, ppz;
		float pyaw, ppitch;

		// Angular error
		float diff_yaw, diff_pitch, angle_mag;

		// Prediction params
		float lead_sec, speed_factor, target_speed;

		// Combat
		float attack_cooldown;
		int hurt_time;

		// Output moves
		float yaw_move, pitch_move;
		bool overshoot;
	};

	static FILE* s_csv = nullptr;
	static long long s_last_flush_us = 0;
	static constexpr long long k_flush_interval_us = 1000000LL; // 1 second
	static constexpr int k_max_buffer = 120; // ~2 min at 1/sec
	static snapshot s_buffer[k_max_buffer];
	static int s_buf_count = 0;

	static void open_csv()
	{
		if (s_csv) return;
		const char* home = getenv("HOME");
		if (!home) return;
		char dirpath[256];
		snprintf(dirpath, sizeof(dirpath), "%s/.minecraft/flaway", home);
		mkdir(dirpath, 0755);
		char path[512];
		snprintf(path, sizeof(path), "%s/.minecraft/flaway/aimbot_telemetry.csv", home);
		s_csv = fopen(path, "a");
		if (s_csv)
		{
			// Write header if file is empty
			fseek(s_csv, 0, SEEK_END);
			long sz = ftell(s_csv);
			if (sz == 0)
			{
				fprintf(s_csv,
					"time_us,phase,"
					"local_px,local_py,local_pz,local_vx,local_vy,local_vz,local_yaw,local_pitch,"
					"player_sprint,player_on_ground,"
					"target_tx,target_ty,target_tz,target_vx,target_vy,target_vz,target_id,target_dist,"
					"target_sprint,target_on_ground,target_health,target_hurt_time,"
					"pred_px,pred_py,pred_pz,pred_yaw,pred_pitch,"
					"diff_yaw,diff_pitch,angle_mag,lead_sec,speed_factor,target_speed,"
					"attack_cooldown,hurt_time,"
					"yaw_move,pitch_move,overshoot\n");
				fflush(s_csv);
			}
			s_last_flush_us = now_us();
		}
	}

	static void flush_csv()
	{
		if (!s_csv || s_buf_count == 0) return;
		locale_t old = uselocale(nullptr);
		locale_t csv_locale = newlocale(LC_NUMERIC_MASK, "C", (locale_t)0);
		uselocale(csv_locale);
		for (int i = 0; i < s_buf_count; i++)
		{
			const snapshot& s = s_buffer[i];
			fprintf(s_csv,
				"%lld,%s,"
				"%.4f,%.4f,%.4f,%.6f,%.6f,%.6f,%.4f,%.4f,"
				"%d,%d,"
				"%.4f,%.4f,%.4f,%.6f,%.6f,%.6f,%d,%.4f,"
				"%d,%d,%.4f,%d,"
				"%.4f,%.4f,%.4f,%.4f,%.4f,"
				"%.6f,%.6f,%.6f,%.6f,%.4f,%.6f,"
				"%.4f,%d,"
				"%.6f,%.6f,%d\n",
				s.time_us, s.phase,
				s.lpx, s.lpy, s.lpz, s.lvx, s.lvy, s.lvz, s.lyaw, s.lpitch,
				s.player_sprint, s.player_on_ground,
				s.ttx, s.tty, s.ttz, s.tvx, s.tvy, s.tvz, s.target_id, s.target_dist,
				s.target_sprint, s.target_on_ground, s.target_health, s.target_hurt_time,
				s.ppx, s.ppy, s.ppz, s.pyaw, s.ppitch,
				s.diff_yaw, s.diff_pitch, s.angle_mag, s.lead_sec, s.speed_factor, s.target_speed,
				s.attack_cooldown, s.hurt_time,
				s.yaw_move, s.pitch_move, s.overshoot ? 1 : 0);
		}
		fflush(s_csv);
		s_buf_count = 0;
		s_last_flush_us = now_us();
		uselocale(old);
		if (csv_locale) freelocale(csv_locale);
	}

	static void record(const snapshot& s)
	{
		if (!globals::aimassist_telemetry_enabled) return;
		open_csv();
		if (s_buf_count < k_max_buffer)
			s_buffer[s_buf_count++] = s;

		long long now = now_us();
		if (now - s_last_flush_us >= k_flush_interval_us || s_buf_count >= k_max_buffer)
			flush_csv();
	}

	static void close_csv()
	{
		flush_csv();
		if (s_csv) { fclose(s_csv); s_csv = nullptr; }
	}
}

